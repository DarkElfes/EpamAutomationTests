{
  "BaseUrl": "https://www.epam.com/",
  "Browser": "chrome",
  "TimeoutSeconds": 20,
  "Browsers": {
    "chrome": {
      "Type": "chrome",
      "Arguments": [
        "--start-maximized",
        "--disable-notifications"
      ]
    },
    "chrome-headless": {
      "Type": "chrome",
      "Arguments": [
        "--headless=new",
        "--start-maximized",
        "--disable-gpu"
      ]
    },
    "firefox": {
      "Type": "firefox",
      "Arguments": [
        "--start-maximized",
        "--disable-notifications"
      ]
    },
    "edge": {
      "Type": "edge",
      "Arguments": [
        "--start-maximized",
        "--disable-notifications"
      ]
    }    
  }  
}